{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "power_record",
  "type": "object",
  "required": [
    "chance",
    "n",
    "sigma_d",
    "mde",
    "delta",
    "n_min",
    "ruling",
    "completeness"
  ],
  "properties": {
    "chance": {
      "type": "number"
    },
    "n": {
      "type": "integer"
    },
    "sigma_d": {
      "type": "number"
    },
    "mde": {
      "type": "number"
    },
    "delta": {
      "type": "number"
    },
    "n_min": {
      "type": "integer"
    },
    "strata": {
      "type": "object"
    },
    "items_filtered_on_outcome": {
      "type": "boolean",
      "description": "must be false, stratify"
    },
    "ruling": {
      "enum": [
        "RESOLVABLE",
        "CLOSE_UNRESOLVABLE",
        "ESCALATE_ENLARGE_PILOT",
        "RUN_AT_LIMIT",
        "UNDEMONSTRATED"
      ],
      "description": "provisional: RESOLVABLE or CLOSE_UNRESOLVABLE. final: RESOLVABLE, RUN_AT_LIMIT or CLOSE_UNRESOLVABLE; ESCALATE_ENLARGE_PILOT and UNDEMONSTRATED leave the scope provisional"
    },
    "completeness": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "provisional",
        "final"
      ],
      "description": "provisional: free I1 variance, a lower bound. final: R3 pilot arm variance, carries the larger MDE"
    },
    "sigma_d_source": {
      "enum": [
        "free_compositions",
        "pilot_arms"
      ]
    },
    "n_pilot": {
      "type": "integer",
      "minimum": 10
    },
    "sigma_d_pilot": {
      "type": "number"
    },
    "mde_pilot": {
      "type": "number"
    },
    "mde_provisional": {
      "type": "number"
    },
    "sigma_d_provisional": {
      "type": "number"
    },
    "licenses": {
      "type": "string"
    },
    "mde_lower": {
      "type": "number"
    },
    "k_cohort": {
      "type": "integer"
    },
    "inv_m_cohort": {
      "type": "number"
    },
    "var_between_free": {
      "type": "number"
    },
    "sigma_item": {
      "type": "number"
    },
    "not_priced": {
      "type": "string"
    }
  }
}