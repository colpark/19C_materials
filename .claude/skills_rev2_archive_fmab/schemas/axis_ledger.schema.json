{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "axis_ledger",
  "type": "object",
  "required": [
    "candidate",
    "branch",
    "axes",
    "ruling",
    "binding_axis",
    "completeness"
  ],
  "properties": {
    "candidate": {
      "type": "string"
    },
    "branch": {
      "enum": [
        "prediction",
        "design"
      ]
    },
    "axes": {
      "type": "array",
      "minItems": 7,
      "description": "seven corpus axes counted at P3, plus channel_lift from I2 on a final ledger. Each entry carries axis, raw, clustered, status"
    },
    "ruling": {
      "enum": [
        "PROCEED",
        "CLOSE",
        "ESCALATE"
      ]
    },
    "binding_axis": {
      "type": "string"
    },
    "definition_widened": {
      "type": "boolean",
      "description": "must be false"
    },
    "completeness": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "provisional",
        "final"
      ],
      "description": "provisional: seven corpus axes counted, licenses I1 and I2 only. final: channel_lift from I2 counted, licenses an arm"
    }
  }
}